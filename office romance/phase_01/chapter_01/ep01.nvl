# 서준, 커피를 건넴 (의외의 배려)
GIVE Park_Seojun Coffee_Can
ACTION GIVE subject=Park_Seojun item=Coffee_Can target=Kim_Jiwoo

# 지우, 팀장의 의외의 모습에 당황
KNOWS Kim_Jiwoo Seojun_Unexpected_Kindness
ACTION SPEAK subject=Kim_Jiwoo fact=Seojun_Unexpected_Kindness

# 서준, 퇴근 권유
KNOWS Park_Seojun Go_Home_Early
ACTION SPEAK subject=Park_Seojun fact=Go_Home_Early target=Kim_Jiwoo

# 관계 변화 시작
RELATE Kim_Jiwoo -> Park_Seojun affinity=20 trust=10

# Episode Goals
GOAL Kim_Jiwoo main=Survive_First_Day sub=Understand_Office_Politics
GOAL Park_Seojun main=Manage_Team sub=Avoid_Personal_Complications
