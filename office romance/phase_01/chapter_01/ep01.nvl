# Episode 1: 첫 출근 (First Day)

# Scene 1: 아침 - 회사 로비
SCENE Scene01_Lobby worldTime=2024-03-04T08:30:00Z narrative=1

# 이 씬에 등장하는 캐릭터들 (APPEAR 명령 테스트)
APPEAR Kim_Jiwoo Lee_Haneul

SET Kim_Jiwoo.location = Company_Lobby
SET Lee_Haneul.location = Company_Lobby

# 지우: 긴장된 첫 출근
KNOWS Kim_Jiwoo Nervous_First_Day
ACTION SPEAK subject=Kim_Jiwoo fact=Nervous_First_Day

# 하늘이 먼저 인사
KNOWS Lee_Haneul Jiwoo_Is_New
ACTION SPEAK subject=Lee_Haneul fact=Jiwoo_Is_New target=Kim_Jiwoo

# 지우, 하늘의 친절에 안도
RELATE Kim_Jiwoo -> Lee_Haneul affinity=60 trust=40

# Scene 2: 마케팅팀 사무실
SCENE Scene02_Office worldTime=2024-03-04T09:00:00Z narrative=2

APPEAR Kim_Jiwoo Lee_Haneul Park_Seojun Director_Kang

SET Kim_Jiwoo.location = Marketing_Office
SET Lee_Haneul.location = Marketing_Office
SET Park_Seojun.location = Marketing_Office
SET Director_Kang.location = Marketing_Office

# 부장님이 신입 소개
KNOWS Director_Kang Jiwoo_Introduction
ACTION SPEAK subject=Director_Kang fact=Jiwoo_Introduction

# 서준 팀장, 무뚝뚝하게 첫 인사
KNOWS Park_Seojun New_Team_Member
ACTION SPEAK subject=Park_Seojun fact=New_Team_Member target=Kim_Jiwoo

# 지우, 팀장의 차가운 인상에 당황
KNOWS Kim_Jiwoo Seojun_Cold_First_Impression

# 자리 배정: 팀장 바로 옆
SET Kim_Jiwoo.location = Desk_Next_To_Seojun

# Scene 3: 점심시간 - 구내식당
SCENE Scene03_Cafeteria worldTime=2024-03-04T12:00:00Z narrative=3

APPEAR Kim_Jiwoo Lee_Haneul Choi_Minji

SET Kim_Jiwoo.location = Cafeteria
SET Lee_Haneul.location = Cafeteria
SET Choi_Minji.location = Cafeteria

# 하늘이 민지에 대한 정보 공유
ACTION SPEAK subject=Lee_Haneul fact=Seojun_Minji_History target=Kim_Jiwoo

# 지우, 이 정보를 알게 됨
KNOWS Kim_Jiwoo Seojun_Minji_History

# 민지가 다가와서 견제
KNOWS Choi_Minji Jiwoo_Sits_Next_To_Seojun
ACTION SPEAK subject=Choi_Minji fact=Jiwoo_Sits_Next_To_Seojun target=Kim_Jiwoo

# 지우, 민지의 적대감 감지
KNOWS Kim_Jiwoo Minji_Is_Hostile
RELATE Kim_Jiwoo -> Choi_Minji affinity=-30 trust=-20

# Scene 4: 야근 - 사무실
SCENE Scene04_LateNight worldTime=2024-03-04T21:00:00Z narrative=4

APPEAR Kim_Jiwoo Park_Seojun

SET Kim_Jiwoo.location = Marketing_Office
SET Park_Seojun.location = Marketing_Office

# 지우, 첫날부터 야근
KNOWS Kim_Jiwoo First_Day_Overtime
