    "mcp": "tsx src/mcp/server.ts",
    "plot:validate": "tsx src/scripts/plot-validate.ts"
  },
  "dependencies": {
    "@google/genai": "^1.40.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.6.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
