{
  "name": "nvl-agent-suite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup:auto": "bash scripts/bootstrap.sh",
    "dev": "tsx src/server/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
