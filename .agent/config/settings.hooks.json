{
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "*",
                "hooks": [
                    {
                        "type": "command",
                        "command": "${AGENT_ROOT}/.agent/skills/core/continuous-learning/hooks/observe.sh pre"
                    }
                ]
            },
            {
                "matcher": "tool == \"task_boundary\"",
                "hooks": [
                    {
                        "type": "command",
                        "command": "${AGENT_ROOT}/.agent/skills/capabilities/memory/scripts/check_stm.sh"
                    }
                ]
            },
            {
                "matcher": "tool == \"replace_file_content\" || tool == \"write_to_file\"",
                "hooks": [
                    {
                        "type": "command",
                        "command": "${AGENT_ROOT}/.agent/skills/core/strategic-compact/suggest-compact.sh"
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "*",
                "hooks": [
                    {
                        "type": "command",
                        "command": "${AGENT_ROOT}/.agent/skills/core/continuous-learning/hooks/observe.sh post"
                    }
                ]
            }
        ],
        "Stop": [
            {
                "type": "command",
                "command": "${AGENT_ROOT}/.agent/skills/capabilities/memory/scripts/suggest_consolidation.sh"
            }
        ]
    }
}