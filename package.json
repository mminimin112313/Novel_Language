{
  "name": "nvl-agent-suite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --exclude '**/novel_test/**'",
    "test:watch": "vitest --exclude '**/novel_test/**'",
    "lint": "tsc -p tsconfig.json --noEmit",
    "setup:doctor": "tsx src/scripts/setup-doctor.ts",
    "compile:file": "tsx src/scripts/compile.ts",
    "compile:cascade": "tsx src/scripts/cascade-compile.ts",
    "aql": "tsx src/scripts/aql.ts",
    "pipeline": "tsx src/scripts/run-pipeline.ts",
    "episode:pack": "tsx src/scripts/episode-pack.ts",
    "manuscript:lint": "tsx src/scripts/manuscript-lint.ts",
    "novel:write": "tsx src/scripts/write-novel.ts",
    "mcp": "tsx src/mcp/server.ts",
    "plot:validate": "tsx src/scripts/plot-validate.ts",
    "setup:auto": "bash scripts/bootstrap.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.6.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}