SET Helen.location = BakerStreet
SET Holmes.location = BakerStreet
SET Watson.location = BakerStreet
KNOWS Helen WhistleHeard
ACTION SPEAK subject=Helen target=Holmes fact=WhistleHeard
SCENE Investigation worldTime=1892-04-01T20:00:00Z narrative=2 mode=normal
SET Holmes.location = Manor
SET Watson.location = Manor
SET Helen.location = Manor
SET Roylott.location = Manor
SEED MilkSaucer target=SnakeLure due=Act3
